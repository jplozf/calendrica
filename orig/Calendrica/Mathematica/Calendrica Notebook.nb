Cell[CellGroupData[{

Cell["Naming Conventions", "Section",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[TextData[{
  StyleBox["The conversion between most names in the Lisp implementation and \
the ",
    Evaluatable->False,
    AspectRatioFixed->True],
  StyleBox["Mathematica",
    Evaluatable->False,
    AspectRatioFixed->True,
    FontSlant->"Italic"],
  StyleBox[" implementation is straightforward: intercapitalization is \
substituted for hyphenated names, and predicates end with \"Q\" instead of \
\"?\". For example, ",
    Evaluatable->False,
    AspectRatioFixed->True],
  StyleBox["no-major-solar-term?",
    Evaluatable->False,
    AspectRatioFixed->True,
    FontWeight->"Bold"],
  StyleBox[" becomes ",
    Evaluatable->False,
    AspectRatioFixed->True],
  StyleBox["NoMajorSolarTermQ[]",
    Evaluatable->False,
    AspectRatioFixed->True,
    FontWeight->"Bold"],
  StyleBox[".\n\nThe only major changes are:\n\n1) Functions which convert to \
and from fixed dates have overloaded names. For example, ",
    Evaluatable->False,
    AspectRatioFixed->True],
  StyleBox["fixed-from-chinese",
    Evaluatable->False,
    AspectRatioFixed->True,
    FontWeight->"Bold"],
  StyleBox[" becomes ",
    Evaluatable->False,
    AspectRatioFixed->True],
  StyleBox["ToFixed[]",
    Evaluatable->False,
    AspectRatioFixed->True,
    FontWeight->"Bold"],
  StyleBox[" which takes a Chinese date, and chinese-from-fixed becomes ",
    Evaluatable->False,
    AspectRatioFixed->True],
  StyleBox["Chinese[]",
    Evaluatable->False,
    AspectRatioFixed->True,
    FontWeight->"Bold"],
  StyleBox[" which takes an integer.\n\n2) Components of dates are accessed \
by functions such as ",
    Evaluatable->False,
    AspectRatioFixed->True],
  StyleBox["CYear[]",
    Evaluatable->False,
    AspectRatioFixed->True,
    FontWeight->"Bold"],
  StyleBox[" which determine the position of the component from the type of \
the date, and replace Lisp functions such as ",
    Evaluatable->False,
    AspectRatioFixed->True],
  StyleBox["standard-year",
    Evaluatable->False,
    AspectRatioFixed->True,
    FontWeight->"Bold"],
  StyleBox[".\n\n3) Certain internal functions such as ",
    Evaluatable->False,
    AspectRatioFixed->True],
  StyleBox["sum",
    Evaluatable->False,
    AspectRatioFixed->True,
    FontWeight->"Bold"],
  StyleBox[" have been renamed (",
    Evaluatable->False,
    AspectRatioFixed->True],
  StyleBox["MSum[]",
    Evaluatable->False,
    AspectRatioFixed->True,
    FontWeight->"Bold"],
  StyleBox[", in this case) to avoid conflicts with already-established ",
    Evaluatable->False,
    AspectRatioFixed->True],
  StyleBox["Mathematica",
    Evaluatable->False,
    AspectRatioFixed->True,
    FontSlant->"Italic"],
  StyleBox[" names.",
    Evaluatable->False,
    AspectRatioFixed->True]
}], "Text",
  Evaluatable->False,
  AspectRatioFixed->True]
}, Open  ]],

Cell[CellGroupData[{

Cell["Getting Started", "Section",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[TextData[{
  StyleBox["Once you have placed the file \"Calendrica.m\" in the root of \
your ",
    Evaluatable->False,
    AspectRatioFixed->True],
  StyleBox["Mathematica",
    Evaluatable->False,
    AspectRatioFixed->True,
    FontSlant->"Italic"],
  StyleBox[" packages hierarchy, this loads it for use: ",
    Evaluatable->False,
    AspectRatioFixed->True]
}], "Text",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[BoxData[
    \(<< Calendrica`\)], "Input",
  AspectRatioFixed->True]
}, Open  ]],

