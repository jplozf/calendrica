Cell["\<\
Prefixing the symbol with ? gives general information on that \
symbol\
\>", "Text",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(?Gregorian\)\)], "Input",
  AspectRatioFixed->True],

Cell[BoxData[
    \("Gregorian represents the present civil (Gregorian) calendar. \
Gregorian[] gives a list of components in Gregorian calendar dates. \
Gregorian[fixedDate] gives the Gregorian calendar date corresponding to the \
given fixed date."\)], "Print"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(?Sunday\)\)], "Input",
  AspectRatioFixed->True],

Cell[BoxData[
    \("Sunday represents a day of the week. Sunday[] gives a corresponding \
numerical constant."\)], "Print"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Constructing a Date", "Section",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell["This shows you all the calendars which Calendrica supports:", "Text",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[CellGroupData[{

Cell[BoxData[
    \(Calendars[]\)], "Input",
  AspectRatioFixed->True],

Cell[BoxData[
    \({Egyptian, Armenian, Gregorian, Julian, Roman, Coptic, Ethiopic, ISO, 
      Islamic, Hebrew, OldHinduSolar, OldHinduLunar, MayanLongCount, 
      MayanHaab, MayanTzolkin, Bahai, ArithmeticPersian, ModifiedFrench, 
      Balinese, ObservationalIslamic, Persian, FutureBahai, French, Chinese, 
      HinduLunar, HinduSolar}\)], "Output"]
}, Open  ]],

Cell["\<\
This displays the components in a date on a given calendar. \
Component names are prefixed with 'C':\
\>", "Text",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[CellGroupData[{

Cell[BoxData[
    \(Gregorian[]\)], "Input",
  AspectRatioFixed->True],

Cell[BoxData[
    \({CYear, CMonth, CDay}\)], "Output"]
}, Open  ]],

Cell[TextData[{
  StyleBox["To construct a date, create a ",
    Evaluatable->False,
    AspectRatioFixed->True],
  StyleBox["Mathematica",
    Evaluatable->False,
    AspectRatioFixed->True,
    FontSlant->"Italic"],
  StyleBox[" expression whose head is the name of the calendar, and whose \
body consists of each component in order:",
    Evaluatable->False,
    AspectRatioFixed->True]
}], "Text",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[CellGroupData[{

Cell[BoxData[
    \(Gregorian[1965, \ 5, 15]\)], "Input",
  AspectRatioFixed->True],

Cell[BoxData[
    InterpretationBox["\<\"Saturday, \\!\\(15\\) May \\!\\(1965\\)\"\>",
      StringForm[ "``, `` `` ``", "Saturday", 15, "May", 1965],
      Editable->False]], "Output"]
}, Open  ]],

Cell["\<\
Calendrica formats the output for easy reading, but keeps the \
internal structure.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(% // FullForm\)], "Input"],

Cell[BoxData[
    TagBox[
      StyleBox[\(Gregorian[1965, 5, 15]\),
        ShowSpecialCharacters->False,
        ShowStringCharacters->True,
        NumberMarks->True],
      FullForm]], "Output"]
}, Open  ]],

Cell["\<\
You can use symbolic constants for the standard months and \
weekdays. Make sure you put empty brackets after all symbolic \
constants.:\
\>", "Text",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[CellGroupData[{

Cell[BoxData[
    \(May\)], "Input",
  AspectRatioFixed->True],

Cell[BoxData[
    \(May\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(May[]\)], "Input",
  AspectRatioFixed->True],

Cell[BoxData[
    \(5\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Gregorian[1965, \ May[], 15]\)], "Input",
  AspectRatioFixed->True],

Cell[BoxData[
    InterpretationBox["\<\"Saturday, \\!\\(15\\) May \\!\\(1965\\)\"\>",
      StringForm[ "``, `` `` ``", "Saturday", 15, "May", 1965],
      Editable->False]], "Output"]
}, Open  ]],

Cell["\<\
You can retrieve components of calendar dates by name, regardless \
of their position in the date:\
\>", "Text",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[CellGroupData[{

Cell[BoxData[
    \(CYear[Gregorian[1965, \ May[], 15]]\)], "Input",
  AspectRatioFixed->True],

Cell[BoxData[
    \(1965\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(HinduLunar[]\)], "Input",
  AspectRatioFixed->True],

Cell[BoxData[
    \({CYear, CMonth, CLeapMonth, CDay, CLeapDay}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(CYear[HinduLunar[2022, \ 2, False, 15, False]]\)], "Input",
  AspectRatioFixed->True],

Cell[BoxData[
    \(2022\)], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Converting to Fixed Dates", "Section",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell["\<\
Any calendar date can be converted to a fixed (R.D.) date by \
passing the calendar date to the routine ToFixed[]:\
\>", "Text",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[CellGroupData[{

Cell[BoxData[
    \(ToFixed[Gregorian[1965, \ May[], 15]]\)], "Input",
  AspectRatioFixed->True],

Cell[BoxData[
    \(717471\)], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Converting to Calendar Dates", "Section",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell["\<\
Any fixed date can be converted into any calendar by passing the \
fixed date to the routine which has the same name as the calendar:\
\>", \
"Text",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[CellGroupData[{

Cell[BoxData[
    \(Gregorian[717471]\)], "Input",
  AspectRatioFixed->True],

Cell[BoxData[
    InterpretationBox["\<\"Saturday, \\!\\(15\\) May \\!\\(1965\\)\"\>",
      StringForm[ "``, `` `` ``", "Saturday", 15, "May", 1965],
      Editable->False]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Chinese[717471]\)], "Input",
  AspectRatioFixed->True],

Cell[BoxData[
    InterpretationBox["\<\"cycle \\!\\(77\\), year Yi-Si, month \\!\\(4\\), \
day \\!\\(15\\)\"\>",
      StringForm[ 
      "cycle ``, year ``-``, ``month ``, day ``", 77, "Yi", "Si", "", 4, 15],
      Editable->False]], "Output"]
}, Open  ]],

Cell["\<\
Note this is not the same as constructing a date from its \
components (described above). In this case, you are passing a single integer; \
in the previous case, you are passing a list of date components.\
\>", "Text",\

  Evaluatable->False,
  AspectRatioFixed->True]
}, Open  ]],

Cell[CellGroupData[{

Cell["Converting Between Calendars", "Section",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell["\<\
To convert a date in one calendar to another calendar in a single \
step, use the ConvertDateTo[] routine:\
\>", "Text",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[CellGroupData[{

Cell[BoxData[
    \(ConvertDateTo[Gregorian[1965, May[], 15], HinduLunar]\)], "Input",
  AspectRatioFixed->True],

Cell[BoxData[
    InterpretationBox["\<\"Sanivara, \\!\\(15\\) Vaisakha \\!\\(2022\\) \
V.E.\"\>",
      StringForm[ 
      "``, ```` ```` `` V.E.", "Sanivara", 15, "", "Vaisakha", "", 2022],
      Editable->False]], "Output"]
}, Open  ]],

Cell["\<\
This converts the result of the previous conversion back to the \
Gregorian calendar:\
\>", "Text",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[CellGroupData[{

Cell[BoxData[
    \(ConvertDateTo[%, Gregorian]\)], "Input",
  AspectRatioFixed->True],

Cell[BoxData[
    InterpretationBox["\<\"Saturday, \\!\\(15\\) May \\!\\(1965\\)\"\>",
      StringForm[ "``, `` `` ``", "Saturday", 15, "May", 1965],
      Editable->False]], "Output"]
}, Open  ]],

