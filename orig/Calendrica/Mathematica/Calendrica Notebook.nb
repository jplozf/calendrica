Cell[CellGroupData[{
Cell[TextData[{
  StyleBox["Calendrica\n",
    FontColor->RGBColor[0.500008, 0.500008, 1]],
  StyleBox["The Millennium Edition",
    FontSize->18]
}], "Title",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell["by Nachum Dershowitz and Edward M. Reingold", "Subtitle",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[TextData[{
  StyleBox["Mathematica",
    Evaluatable->False,
    AspectRatioFixed->True,
    FontSize->18,
    FontSlant->"Italic"],
  StyleBox[" translation version 2.0 by Robert C. McNally ",
    Evaluatable->False,
    AspectRatioFixed->True,
    FontSize->18],
  StyleBox["<calendrica@dangerousgames.com>",
    Evaluatable->False,
    AspectRatioFixed->True,
    FontSize->18,
    FontSlant->"Italic"]
}], "Text",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[TextData[{
  StyleBox["Calendrica is a package for generalized manipulation and \
conversion of dates through various modern and historical calendars. It is \
based on the work of Nachum Dershowitz and Edward M. Reingold in their book ",
    
    Evaluatable->False,
    AspectRatioFixed->True],
  ButtonBox["Calendrical Calculations",
    ButtonData:>{
      URL[ "http://www.calendarists.com"], None},
    ButtonStyle->"Hyperlink"],
  StyleBox[", the Millennium Edition, published by Cambridge University \
Press.",
    Evaluatable->False,
    AspectRatioFixed->True]
}], "Text",
  Evaluatable->False,
  AspectRatioFixed->True]
}, Open  ]],

Cell[CellGroupData[{

Cell["Version Notes", "Section",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[CellGroupData[{

Cell["2.0 (20 March 2000)", "Subsection"],

Cell["\<\
Calendrica 2.0 has beeen completely updated to conform with \
Calendrical Calculations, the Millennium Edition. This includes such \
additions as support for Egyptian, Armenian, Roman, Islamic Observational, \
Arithmetic Persian, and Balinese calendars, as well as many improvements and \
bug fixes over the previous version. Most functions are compatible with \
Calendrica 1.0, but compatibilty is not guaranteed.\
\>", "Text"]
}, Open  ]]
}, Open  ]],

