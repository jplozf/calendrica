Cell[CellGroupData[{

Cell["Converting Times of Day", "Section",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(?TimeOfDay\)\)], "Input",
  AspectRatioFixed->True],

Cell[BoxData[
    \("TimeOfDay represents a time of day. TimeOfDay[tee] gives the time of \
day from moment $tee$. TimeOfDay[] gives a list of components in a time of \
day."\)], "Print"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(TimeOfDay[]\)], "Input",
  AspectRatioFixed->True],

Cell[BoxData[
    \({CHour, CMinute, CSecond}\)], "Output"]
}, Open  ]],

Cell["This represents 3:30:10 AM:", "Text",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[CellGroupData[{

Cell[BoxData[
    \(TimeOfDay[3, 30, 10]\)], "Input",
  AspectRatioFixed->True],

Cell[BoxData[
    \("03:30:10 A.M."\)], "Output"]
}, Open  ]],

Cell["To convert the last expression to a fraction of a day:", "Text",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[CellGroupData[{

Cell[BoxData[
    \(ToMoment[%]\)], "Input",
  AspectRatioFixed->True],

Cell[BoxData[
    \(1261\/8640\)], "Output"]
}, Open  ]],

Cell["\<\
And this converts a fixed date which may include a fraction of a \
day to a time of day:\
\>", "Text",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[CellGroupData[{

Cell[BoxData[
    \(TimeOfDay[%]\)], "Input",
  AspectRatioFixed->True],

Cell[BoxData[
    \("03:30:10 A.M."\)], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Current Date and Time", "Section",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[BoxData[
    \(\(?CurrentDate\)\)], "Input"],

Cell[BoxData[
    \("CurrentDate[] gives the current fixed date according to the computer's \
clock, in local time."\)], "Print"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Gregorian[CurrentDate[]]\)], "Input"],

Cell[BoxData[
    InterpretationBox["\<\"Monday, \\!\\(20\\) March \\!\\(2000\\)\"\>",
      StringForm[ "``, `` `` ``", "Monday", 20, "March", 2000],
      Editable->False]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(?CurrentMoment\)\)], "Input"],

Cell[BoxData[
    \("CurrentMoment[] gives the fixed moment according to the computer's \
clock, in local time."\)], "Print"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(TimeOfDay[CurrentMoment[]]\)], "Input"],

Cell[BoxData[
    \("10:36:24 A.M."\)], "Output"]
}, Open  ]],

Cell["\<\
The following won't work because calendar conversions only work on \
integers.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Gregorian[CurrentMoment[]]\)], "Input"],

Cell[BoxData[
    \("Gregorian[730199.4420486111111111111111111111`16.8206]"\)], "Output"]
}, Open  ]],

Cell["This will work.", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(Gregorian[Floor[CurrentMoment[]]]\)], "Input"],

Cell[BoxData[
    InterpretationBox["\<\"Monday, \\!\\(20\\) March \\!\\(2000\\)\"\>",
      StringForm[ "``, `` `` ``", "Monday", 20, "March", 2000],
      Editable->False]], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Locations", "Section",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell["\<\
A number of functions take a location on the Earth's surface as an \
argument.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(?Location\)\)], "Input"],

Cell[BoxData[
    \("Location represents a location on the Earth's surface. Location[] \
gives a list of components in a Location."\)], "Print"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Location[]\)], "Input"],

Cell[BoxData[
    \({CPlaceName, CLatitude, CLongitude, CElevation, CZone}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(?CZone\)\)], "Input"],

Cell[BoxData[
    \("CZone[locale] returns the time zone (as an offset from universal time) \
of Location $locale$."\)], "Print"]
}, Open  ]],

Cell["\<\
Locations needed by the various calendars are built-in, along with \
a couple of sample Locations that have nothing to do with the calendrs.\
\>", \
"Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(LosAngeles[]\)], "Input"],

Cell[BoxData[
    InterpretationBox["\<\"Los Angeles, CA, USA: lat. \\!\\(\\\"34.067\\\"\\) \
N, long. \\!\\(\\\"118.25\\\"\\) W, elev. \\!\\(0\\), zone \
\\!\\(\\\"-8.\\\"\\)\"\>",
      StringForm[ 
      "``: lat. `` ``, long. `` ``, elev. ``, zone ``", 
        "Los Angeles, CA, USA", 
        NumberForm[ 34.06666666666667, {5, 3}], "N", 
        NumberForm[ 118.25, {5, 3}], "W", 0, 
        NumberForm[ -8.0, {4, 2}]],
      Editable->False]], "Output"]
}, Open  ]],

Cell["\<\
Calendrica formats the output for easy reading, but keeps the \
internal structure.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(% // InputForm\)], "Input"],

Cell["Location[\"Los Angeles, CA, USA\", 511/15, -473/4, 0, -8]", "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Urbana[]\)], "Input"],

Cell[BoxData[
    InterpretationBox["\<\"Urbana, IL, USA: lat. \\!\\(\\\"40.1\\\"\\) N, \
long. \\!\\(\\\"88.2\\\"\\) W, elev. \\!\\(225\\), zone \
\\!\\(\\\"-6.\\\"\\)\"\>",
      StringForm[ 
      "``: lat. `` ``, long. `` ``, elev. ``, zone ``", "Urbana, IL, USA", 
        NumberForm[ 40.100000000000001, {5, 3}], "N", 
        NumberForm[ 88.200000000000003, {5, 3}], "W", 225, 
        NumberForm[ -6.0, {4, 2}]],
      Editable->False]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Jerusalem[]\)], "Input"],

Cell[BoxData[
    InterpretationBox["\<\"Jerusalem, Israel: lat. \\!\\(\\\"31.8\\\"\\) N, \
long. \\!\\(\\\"35.2\\\"\\) E, elev. \\!\\(800\\), zone \\!\\(\\\"2.\\\"\\)\"\
\>",
      StringForm[ 
      "``: lat. `` ``, long. `` ``, elev. ``, zone ``", "Jerusalem, Israel", 
        NumberForm[ 31.800000000000001, {5, 3}], "N", 
        NumberForm[ 35.200000000000003, {5, 3}], "E", 800, 
        NumberForm[ 2.0, {4, 2}]],
      Editable->False]], "Output"]
}, Open  ]],

Cell["Here is a calculation involving a Location.", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(?Sunrise\)\)], "Input"],

Cell[BoxData[
    \("Sunrise[date, locale] gives the standard time of sunrise on $date$ at \
$locale$."\)], "Print"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(?LocalFromStandard\)\)], "Input"],

Cell[BoxData[
    \("LocalFromStandard[teeS, locale] gives the local time from standard \
$teeS$ at $locale$."\)], "Print"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Sunrise[ToFixed[Gregorian[2000, 1, 1]], Jerusalem[]] // 
      InputForm\)], "Input"],

Cell["730120.2739098221", "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(LocalFromStandard[%, Jerusalem[]] // InputForm\)], "Input"],

Cell["730120.2883542666", "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(TimeOfDay[%]\)], "Input"],

Cell[BoxData[
    \("06:55:13 A.M."\)], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Validating Data Types", "Section",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell["\<\
Each structured data type has a corresponding function that \
validates it.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(?Gregorian\)\)], "Input"],

Cell[BoxData[
    \("Gregorian represents the present civil (Gregorian) calendar. \
Gregorian[] gives a list of components in Gregorian calendar dates. \
Gregorian[fixedDate] gives the Gregorian calendar date corresponding to the \
given fixed date."\)], "Print"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(?GregorianQ\)\)], "Input"],

Cell[BoxData[
    \("GregorianQ[date] gives True if $date$ is a valid Gregorian date, False \
otherwise."\)], "Print"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Gregorian[]\)], "Input"],

Cell[BoxData[
    \({CYear, CMonth, CDay}\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(GregorianQ[Gregorian[1965, 5, 15]]\)], "Input"],

Cell[BoxData[
    \(True\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(GregorianQ[Gregorian[1965, 5, 15, 1]]\)], "Input"],

Cell[BoxData[
    \(False\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(GregorianQ[Roman[1965, 5, 15]]\)], "Input"],

Cell[BoxData[
    \(False\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(GregorianQ[Gregorian[1965, True, 15]]\)], "Input"],

Cell[BoxData[
    \(False\)], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(?LocationQ\)\)], "Input"],

Cell[BoxData[
    \("LocationQ[location] gives True if location is a valid Location, False \
otherwise."\)], "Print"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(?TimeOfDayQ\)\)], "Input"],

Cell[BoxData[
    \("TimeOfDayQ[time] gives True if $time$ is a valid TimeOfDay, False \
otherwise."\)], "Print"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Accessing Non-Global Symbols", "Section",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[TextData[{
  "Previous versions of Calendrica only exported a subset of all routines to \
the global namespace, requiring manipulation of the ",
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  " context to access some routines. This version exports almost every \
routine to the global namespace, except for minor housekeeping functions, and \
data structures used internally."
}], "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Test Suite", "Section",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[TextData[{
  StyleBox["Calendrica includes a test suite to help ensure the accuracy of \
its algorithms. For each calendar, the test suite converts a list of 33 fixed \
dates to calendar dates and compares its results with a table of calendar \
dates transcribed by hand from ",
    Evaluatable->False,
    AspectRatioFixed->True],
  StyleBox["Calendrical Calculations",
    Evaluatable->False,
    AspectRatioFixed->True,
    FontSlant->"Italic"],
  StyleBox[". It then converts the list of calendar dates in the table back \
to fixed dates, and compares its results with the table of fixed dates. If \
any discrepancies are found, a list including the fixed dates and calendar \
dates from the tables is generated and printed instead of \"OK\". The test \
suite can take a number of minutes to run:",
    Evaluatable->False,
    AspectRatioFixed->True]
}], "Text",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[CellGroupData[{

Cell[BoxData[
    \(CalendricaTest[]\)], "Input",
  AspectRatioFixed->True],

Cell["\<\
